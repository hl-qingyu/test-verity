DATABASE_URL=postgresql+psycopg://verity:CHANGE_ME@127.0.0.1:5432/verity
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Enable only when serving the application over HTTPS.
AUTH_COOKIE_SECURE=false
# Generate one Fernet key for AI credential storage; preserve it across restarts.
AI_ENCRYPTION_KEY=
AI_ALLOWED_BASE_URLS=["https://api.openai.com/v1","https://sub2api.geekuat.com","https://sub2api.geekuat.com/v1"]
# Optional; defaults to backend/storage/code-analysis-results.
# CODE_ANALYSIS_RESULT_PATH=
# Shared model-call budgets (API probes and worker jobs).
AI_MAX_CONCURRENT=2
AI_MAX_PER_USER=1
AI_MAX_PER_CREDENTIAL=1
# Absolute path to the backend's Windows Codex CLI executable.
# AI_CLI_EXECUTABLE=D:/deployment/codex/codex.exe
# AI_CLI_NODE_EXECUTABLE=D:/nodejs/node.exe
# AI_CLI_WORK_PATH=D:/deployment/private/codex-exec
