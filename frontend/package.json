    "react-router-dom": "7.6.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.1",
    "eslint": "9.28.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "globals": "16.2.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.3.5"
  }
